# Upstash Redis — Vercel dev pulls these into .env.development.local
KV_REST_API_URL=https://your-redis-endpoint.upstash.io
KV_REST_API_TOKEN=your-redis-token

# Direct Upstash fallback (optional)
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Ably (realtime push) — server-side secret only, used for REST publish +
# minting scoped subscribe tokens. Never exposed to the browser directly;
# clients fetch a short-lived token from /api/ably-token instead.
# Must also be added to the Vercel project's env vars (all environments).
ABLY_API_KEY=appId.keyId:keySecret

# Next.js Environment
NODE_ENV=development